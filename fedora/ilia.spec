# Generated by porting/scripts/gen-fedora-packaging.py from ilia/debian/. Do not edit by hand.
Name:           ilia
Version:        0.20.1
Release:        1%{?dist}
Summary:        General purpose desktop executor
License:        Apache-2.0
URL:            https://github.com/regolith-linux/ilia
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  make
BuildRequires:  meson
BuildRequires:  gcc
BuildRequires:  gettext
BuildRequires:  intltool
BuildRequires:  pkgconfig(gee-0.8)
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  pkgconfig(gtk+-3.0)
BuildRequires:  pkgconfig(jsonrpc-glib-1.0)
BuildRequires:  pkgconfig(gtk-layer-shell-0)
BuildRequires:  gobject-introspection-devel
BuildRequires:  pkgconfig(xtst)
BuildRequires:  vala

Requires:       tinysparql

%description
Invoke actions upon apps, commands, notifications,
and keybindings via a simple filterable menu.

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build MESON_FLAGS="--buildtype=plain"

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > ilia.files

%files -f ilia.files

